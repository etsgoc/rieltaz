{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core": [
        "../packages/core/src"
      ],
      "@data/*": [
        "../data/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/core/src"
  ]
}
